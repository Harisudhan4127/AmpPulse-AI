# Copy this file to .env and adjust values for your machine.
# Never commit the real .env file to version control.

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database (SQLite file for MVP; swap to Postgres URL for production) ---
DATABASE_URL=sqlite:///./amppulse.db

# --- Security ---
# Secret used to sign user session (JWT) tokens. Generate a real random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_long_random_value
JWT_EXPIRE_MINUTES=1440

# Master key used ONLY to register brand-new devices (device provisioning).
# Each device then gets its OWN per-device key stored in the DB - this master
# key is not distributed to devices after that point.
DEVICE_PROVISION_KEY=change_this_provisioning_key

# --- CORS (frontend origins allowed to call this API) ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# --- Seed demo user (created on first run if it doesn't exist) ---
SEED_USER_EMAIL=demo@amppulse.ai
SEED_USER_PASSWORD=Demo@12345
